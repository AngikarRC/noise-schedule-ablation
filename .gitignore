# The dataset. LLVIP is not ours to redistribute and its licence covers
# non-commercial research use only. data/cache holds resized copies of it and
# rebuilds in a few minutes from the tracked manifests, so neither is tracked.
LLVIP/
data/cache/

# Intermediate LoRA adapters, five per run at 12.8 MB each. The images they
# produced are tracked under outputs/run*/ckpt-*, and the final adapter for
# each run sits at outputs/runA/ and outputs/runB/, so these add 128 MB
# without adding anything a reader needs.
outputs/*/checkpoint-*/

# Generated during a run but reproducible, and large enough not to be worth it.
report/code_diff.txt

.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# Tracked on purpose, listed here so nobody adds them to the ignore list later:
#   data/*.txt                 the split; without it the runs cannot be reproduced
#   schedules/                 the alpha_bar arrays and both checksums, which are
#                              the evidence that Run B used the modified schedule
#   logs/                      env.json and the loss CSVs
#   outputs/run0/              Run 0 baseline images
#   outputs/run*/final/        final test-set images
#   outputs/run*/ckpt-*/       samples at each epoch boundary
#   outputs/run*/schedule/     what each run actually trained with
#   outputs/run*/pytorch_lora_weights.safetensors    the final adapter
#   trajectories/              the x_t captures
#   report/figures/            the plots and comparison grids
#   report/metrics.csv         the scores table
